# The app's environment contract: the ONLY way it gets its settings and secrets.
# Copy this file to .env for a local run (`npm run dev`, `npm run migrate`). Never commit .env.
# When the app is deployed, the platform sets every one of these for you.

# The one port the app listens on. In production it serves the web app and /api on it.
PORT=3000

# The address people open the app at. Use it for absolute links (emails, redirects, webhooks).
PUBLIC_URL=http://localhost:3000

# The app's MongoDB database. The database name is the path (here: app).
MONGODB_URI=mongodb://localhost:27017/app

# Maitento, the AI framework. Leave MAITENTO_API_KEY empty and the app still runs: AI features answer
# "AI not connected". With a key, also set the namespace the app's definitions (maitento/) are deployed to.
MAITENTO_BASE_URL=https://api.maitento.com
MAITENTO_API_KEY=
MAITENTO_NAMESPACE=

# Simulated source data used when an analyst runs the four checks. Set in the platform Settings page.
# Allowed: clean, disputed_invoice, low_bureau, returned_cheques.
SIMULATED_DATA_SCENARIO=clean

# The least important log lines the app writes: debug, info, warn or error (default info).
LOG_LEVEL=info
