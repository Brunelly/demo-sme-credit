{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A React + Node + MongoDB app with AI features built on Maitento.",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p . && npm run build --workspaces --if-present",
    "typecheck": "tsc -p . && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run check",
    "test:watch": "vitest",
    "check": "npm run check:tokens && npm run check:design && npm run check:maitento",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:design": "impeccable detect apps/web/src packages/ui/src",
    "check:maitento": "node .agents/skills/maitento/scripts/check-mtr.cjs ./maitento",
    "migrate": "npm run migrate --workspace @app/api",
    "start": "npm run start --workspace @app/api",
    "maitento:validate": "npm run maitento:validate --workspace @app/api",
    "maitento:deploy": "npm run maitento:deploy --workspace @app/api"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "impeccable": "4.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
